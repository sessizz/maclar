@{
    var nav = ViewData["Nav"] as string ?? "matches";
    var showSearch = ViewData["ShowSearch"] as bool? ?? true;
    var searchValue = ViewData["Search"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Maç Takvimi</title>
    <meta name="description" content="İstanbul voleybol maç takvimi: tarih, saat, salon, takımlar, küme ve skorlar." />
    @* Tema, sayfa çizilmeden önce uygulanır ki açık/koyu arasında parlama olmasın. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (dark) document.documentElement.classList.add('dark');
            } catch (e) { }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="wrap hbar">
            <a class="brand" asp-controller="Matches" asp-action="Index">
                <span class="logo" aria-hidden="true"><partial name="_Icon" model="@("volleyball")" /></span>
                Maç Takvimi
            </a>
            <nav class="nav" aria-label="Ana menü">
                <a asp-controller="Matches" asp-action="Index" class="@(nav == "matches" ? "on" : null)" aria-current="@(nav == "matches" ? "page" : null)">Maçlar</a>
                <a asp-controller="Matches" asp-action="Venues" class="@(nav == "venues" ? "on" : null)" aria-current="@(nav == "venues" ? "page" : null)">Salonlar</a>
                <a asp-controller="Matches" asp-action="Past" class="@(nav == "past" ? "on" : null)" aria-current="@(nav == "past" ? "page" : null)">Geçmiş</a>
            </nav>
            <div class="spacer"></div>
            @if (showSearch)
            {
                <div class="search" role="search">
                    <partial name="_Icon" model="@("search")" />
                    <label class="sr-only" for="matchSearch">Ara</label>
                    <input id="matchSearch" class="input" type="search" autocomplete="off"
                           placeholder="Takım, salon, küme ara..." value="@searchValue"
                           title="Birden fazla kelimeyle aynı anda arayabilirsiniz. Örnek: fener mdk 22.11" />
                    <kbd class="kbd" aria-hidden="true">/</kbd>
                </div>
            }
            <button class="btn btn-ghost" type="button" id="themeToggle" aria-label="Açık / koyu tema">
                <span class="icon-sun"><partial name="_Icon" model="@("sun")" /></span>
                <span class="icon-moon"><partial name="_Icon" model="@("moon")" /></span>
            </button>
        </div>
    </header>

    <main class="wrap main" role="main">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
